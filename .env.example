HEALTHNEXUS_STORAGE=local
HEALTHNEXUS_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Portable backend entrypoint; Docker/Cloud Run supplies PORT. One process per instance.
PORT=8000
# Optional Compose host port overrides (container ports remain 8000 and 80).
HEALTHNEXUS_BACKEND_PORT=8000
HEALTHNEXUS_FRONTEND_PORT=4200
# Profiles are selected explicitly per request/UI: constrained or redistribution-ready.
# Immutable assets: data/generated, artifacts/models, artifacts/planning, data/demo.
# New workflows use bounded process-local state; federation writes artifacts/federation.
# Compose deliberately disables Gemini and never passes GEMINI_API_KEY.
# Set only when explicitly choosing Firestore. Credentials stay on the backend.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
# Server-side only. Restart the backend after configuration changes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_PRIMARY=gemini-3.8-flash
GEMINI_MODEL_FALLBACKS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_FAILOVER_ENABLED=true
GEMINI_ENABLED=true
GEMINI_THINKING_LEVEL=medium
# Verifier-only hard cap (1–10), including provider retries; not a Google quota override.
GEMINI_DAILY_VERIFICATION_BUDGET=10
