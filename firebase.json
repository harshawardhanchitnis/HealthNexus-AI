{
  "hosting": {
    "public": "frontend/dist/healthnexus-frontend/browser",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {"source": "/api/**", "run": {"serviceId": "healthnexus-api", "region": "asia-south1"}},
      {"source": "**", "destination": "/index.html"}
    ]
  },
  "firestore": {"rules": "firestore.rules"}
}
